# Gawali backend configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Django -----------------------------------------------------------------
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# True only on your own machine. The server refuses to start without a secret key when this is False.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Use config.settings.production on servers (forces PostgreSQL, HTTPS and secure cookies).
DJANGO_SETTINGS_MODULE=config.settings.local

# --- Database ---------------------------------------------------------------
# Either a full URL (wins when DB_ENGINE=postgres), e.g. Supabase's IPv4 session pooler:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# ...or the individual fields below.
# postgres (recommended) or sqlite (quick local experiments only).
DB_ENGINE=postgres
DB_NAME=gawali_db
DB_USER=gawali_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# disable | prefer | require (use require for managed cloud databases)
DB_SSLMODE=prefer
# Seconds to keep connections open between requests.
DB_CONN_MAX_AGE=60
# Only used when DB_ENGINE=sqlite.
SQLITE_PATH=gawali.sqlite3

# --- Redis & Celery (scheduled delivery manifests, monthly billing) --------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# --- NVIDIA AI (free models from build.nvidia.com) --------------------------
# Get a free key at https://build.nvidia.com. Leave blank to run AI features in offline "rules" mode.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional second key, used automatically if the first is rate-limited.
NVIDIA_API_KEY_ALT=
# One model per job:
NVIDIA_CHAT_MODEL=minimaxai/minimax-m3.1-flash            # customer support assistant
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b # refund photo verification
NVIDIA_INSIGHT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b # dairy insights, recommendations, route briefs
NVIDIA_PARSE_MODEL=nvidia/nemotron-parse                   # lab report parsing (Quality lab)
NVIDIA_TIMEOUT_SECONDS=25

# --- Payments -----------------------------------------------------------------
# Off: top-up / withdraw / Autopay are hidden and the ledger is settled with the dairy offline.
PAYMENTS_ENABLED=False

# --- Razorpay -----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Business defaults --------------------------------------------------------
DEFAULT_CUTOFF_TIME=22:00:00
DEFAULT_BILLING_CYCLE=monthly
# How many days back a gawali may sync offline delivery updates.
DELIVERY_SYNC_WINDOW_DAYS=2

# --- Production only ------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
