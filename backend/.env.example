# Gawali Backend Environment Configuration
DJANGO_SECRET_KEY=django-insecure-gawali-enterprise-platform-milk-subscription-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL) - Defaults to SQLite when DB_ENGINE is sqlite
DB_ENGINE=sqlite
DB_NAME=gawali_db
DB_USER=gawali_user
DB_PASSWORD=gawali_secure_password_2026
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://10.0.2.2:8000,http://127.0.0.1:8000

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_gawali_platform_key
RAZORPAY_KEY_SECRET=rzp_test_secret_gawali_2026
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_gawali_2026

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Business Defaults
DEFAULT_CUTOFF_TIME=22:00:00
DEFAULT_BILLING_CYCLE=monthly
