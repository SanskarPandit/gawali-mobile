{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "services": {
    "web": {
      "root": "web/",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": "backend/",
      "framework": "django",
      "functions": {
        "config/wsgi.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,scripts/**,venv/**,media/**,staticfiles/**,**/__pycache__/**,*.sqlite3,schema.yml,.coverage,.pytest_cache/**,requirements-dev.txt,run_production.ps1}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/media/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/v2/cron/tick",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/v2/cron/tick",
      "schedule": "5 1 * * *"
    },
    {
      "path": "/api/v2/cron/tick",
      "schedule": "5 2 * * *"
    },
    {
      "path": "/api/v2/cron/tick",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/v2/cron/tick",
      "schedule": "5 4 * * *"
    },
    {
      "path": "/api/v2/cron/tick",
      "schedule": "5 5 * * *"
    },
    {
